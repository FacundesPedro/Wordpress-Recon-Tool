# Target and scan configuration
WP_TARGET=https://example.com
WP_PROFILE=light
WP_OUTPUT_FORMAT=markdown
WP_ORGANIZE_BY_TARGET=true   # write each target's reports/raw into <output>/<host>/
WP_THREADS=2
WP_TIMEOUT=10
WP_LOG_LEVEL=INFO

# Step relations / parallel execution (off by default)
# WP_PARALLEL_STEPS=false        # run a tier's steps as a dependency graph
# WP_STEP_CONCURRENCY=0          # max concurrent steps (0 = WP_THREADS)

# WordPress authentication (for authenticated scan)
# WP_USER=admin
# WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# WP_AUTH_METHOD=app_password

# WPScan integration
# WP_WPSCAN_API_TOKEN=your_token

# Nuclei integration
# WP_NUCLEI_SEVERITY=medium,high,critical
# WP_NUCLEI_THREADS=25          # -concurrency (alias: --nuclei-concurrency)
# WP_NUCLEI_RATE_LIMIT=150      # -rl (alias: --nuclei-rate-limit)

# Shodan integration
# WP_SHODAN_API_KEY=your_key

# FFUF fuzzer
# WP_FFUF_WORDLIST=/path/to/wordlist
# WP_FFUF_DIRECTORY_WORDLIST=/path/to/directories.txt
# WP_FFUF_FILES_WORDLIST=/path/to/files.txt
# WP_FFUF_WP_WORDLIST=/path/to/wp-paths.txt
# WP_FFUF_THREADS=40            # -t
# WP_FFUF_RATE_LIMIT=0         # -rate (requests/second, 0 = unlimited)
# WP_FFUF_HTTP_TIMEOUT=10      # per-request HTTP timeout
# WP_FFUF_FILTER_STATUS=404

# Raw external-tool output (additive; never affects the report)
# WP_SAVE_RAW=true
# WP_RAW_OUTPUT_DIR=            # default: <output>/raw
# WP_RAW_MAX_BYTES=5000000      # per-artifact cap (0 = unlimited)
# WP_RAW_NO_REDACT=false        # debug only: persist secrets unredacted
# WP_RAW_HISTORY=true          # archive prior <step>.* into raw/history/<run-id>/

# Pre-flight reachability + split-horizon targets
# WP_RETRIES=2                  # extra attempts on transient pre-flight failures
# WP_RETRY_DELAY=1.0            # base backoff between retries (exponential)
# WP_TARGET_IP=10.0.0.5         # single target: connect here, keep host for Host/SNI
# WP_DNS_RESOLVE=app.io:10.0.0.5,api.io:10.0.0.6   # per-host IP overrides

# OpenDoor scanner
# WP_OPENDOOR_MODE=wp_paths
# WP_OPENDOOR_WORDLIST=/path/to/wordlist
# WP_OPENDOOR_DELAY=0.5

# Wordlist overrides (empty = built-in resolution chain)
# WP_WORDLIST=/path/to/credentials.txt
# WP_LOGIN_WORDLIST=/path/to/login-credentials.txt
# WP_PLUGIN_WORDLIST=/path/to/plugins.txt
# WP_THEME_WORDLIST=/path/to/themes.txt
# WP_SOURCE_ASSETS=/path/to/assets.txt
# WP_API_PATHS=/path/to/api-paths.txt
# WP_ADMIN_PATHS=/path/to/admin-paths.txt

# Content spider limits
# WP_SPIDER_MAX_DEPTH=2
# WP_SPIDER_MAX_PAGES=50

# Nmap integration (tools module)
# WP_ENABLE_NMAP=false
# WP_ENABLE_NMAP_SCRIPTS=false
# WP_NMAP_TOP_PORTS=100
# WP_NMAP_PORTS=
# WP_NMAP_TIMEOUT=300

# Webapp / source review (webapp module)
# WP_SOURCE_SCAN_MAX_JS=20
# WP_SOURCE_SCAN_MAX_BYTES=1000000
# WP_SOURCE_SCAN_SOURCEMAPS=true
# WP_SOURCE_SCAN_FUZZ=true
# WP_WEBAPP_MAX_PAGES=10

# Public OSINT (crt.sh, wayback) — disable on filtered/internal engagements
# WP_PASSIVE_OSINT=true

# Active testing extra targets (SPA support)
# WP_ACTIVE_PARAMS=/api/items:id,/api/search:q   # operator-supplied path:param
# WP_ACTIVE_JS_MAX=5                              # JS bundles parsed for API endpoints/params

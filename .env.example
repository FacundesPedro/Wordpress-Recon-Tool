# Target and scan configuration
WP_TARGET=https://example.com
WP_PROFILE=light
WP_OUTPUT_FORMAT=markdown
WP_THREADS=2
WP_TIMEOUT=10
WP_LOG_LEVEL=INFO

# WordPress authentication (for authenticated scan)
# WP_USER=admin
# WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# WP_AUTH_METHOD=app_password

# WPScan integration
# WP_WPSCAN_API_TOKEN=your_token

# Nuclei integration
# WP_NUCLEI_SEVERITY=medium,high,critical

# Shodan integration
# WP_SHODAN_API_KEY=your_key

# FFUF fuzzer
# WP_FFUF_WORDLIST=/path/to/wordlist

# OpenDoor scanner
# WP_OPENDOOR_MODE=wp_paths

# Content spider limits
# WP_SPIDER_MAX_DEPTH=2
# WP_SPIDER_MAX_PAGES=50

# Nmap integration (tools module)
# WP_ENABLE_NMAP=false
# WP_ENABLE_NMAP_SCRIPTS=false
# WP_NMAP_TOP_PORTS=100
# WP_NMAP_PORTS=
# WP_NMAP_TIMEOUT=300

# Webapp / source review (webapp module)
# WP_SOURCE_SCAN_MAX_JS=20
# WP_SOURCE_SCAN_MAX_BYTES=1000000
# WP_SOURCE_SCAN_SOURCEMAPS=true
# WP_SOURCE_SCAN_FUZZ=true
# WP_WEBAPP_MAX_PAGES=10
